{
  "name": "Inventory · Order intake",
  "nodes": [
    {
      "id": "6f1c2a3e-0b4d-4f6a-9a51-1c2d3e4f5a61",
      "name": "Order created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [0, 0],
      "webhookId": "a3f5c1d2-7e8b-4c9d-8e1f-2a3b4c5d6e71",
      "parameters": {
        "httpMethod": "POST",
        "path": "inv-order-created",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "0c2e7d41-5a8f-4b3c-9d6e-7f8a9b0c1d22",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "disabled": true,
      "notes": "Optional. Enable after setting INVENTORY_WEBHOOK_SECRET and NODE_FUNCTION_ALLOW_BUILTIN=crypto on the n8n service (both are in docker-compose.yml).",
      "parameters": {
        "jsCode": "// Rejects deliveries that were not signed with WEBHOOK_SECRET by the inventory API.\nconst crypto = require('crypto');\nconst secret = $env.INVENTORY_WEBHOOK_SECRET;\nfor (const item of $input.all()) {\n  const h = item.json.headers;\n  const body = JSON.stringify(item.json.body);\n  const expected = 'sha256=' + crypto.createHmac('sha256', secret).update(`${h['x-inventory-timestamp']}.${body}`).digest('hex');\n  if (expected !== h['x-inventory-signature']) {\n    throw new Error('Invalid inventory webhook signature');\n  }\n}\nreturn $input.all();"
      }
    },
    {
      "id": "3b9d1f72-8c4a-4e5b-a6d7-0e1f2a3b4c83",
      "name": "Backordered?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [440, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "c4d5e6f7-1a2b-4c3d-8e9f-0a1b2c3d4e94",
              "leftValue": "={{ $json.body.data.status }}",
              "rightValue": "backordered",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "9e8d7c6b-5a4f-4e3d-b2c1-a0f9e8d7c6a5",
      "name": "Shortages to restock lines",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, -100],
      "parameters": {
        "jsCode": "// One purchase order request per short SKU.\n// atLeast = the shortfall; the API rounds up to the product's reorder quantity.\nconst order = $input.first().json.body.data;\nreturn order.shortages.map((s) => ({\n  json: { sku: s.sku, atLeast: s.short, reason: `backorder ${order.id}` },\n}));"
      }
    },
    {
      "id": "1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4cb6",
      "name": "Create purchase order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [880, -100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "inventoryApiKey",
          "name": "Inventory API key"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INVENTORY_API_URL }}/api/purchase-orders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ sku: $json.sku, atLeast: $json.atLeast, reason: $json.reason }) }}",
        "options": {}
      }
    },
    {
      "id": "7c8d9e0f-1a2b-4c3d-9e4f-5a6b7c8d9ec7",
      "name": "Ready to pick (connect a pick list)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [660, 100],
      "notes": "Stock is reserved. Swap this for Google Sheets, Slack or an email to the warehouse.",
      "parameters": {}
    }
  ],
