{
  "name": "Inventory · Low stock reorder (custom nodes)",
  "nodes": [
    {
      "id": "4a6c8e0a-2c4e-4a6c-8e0a-2c4e6a8c0e91",
      "name": "Inventory Trigger",
      "type": "CUSTOM.inventoryTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "webhookId": "f0a2c4e6-8a0c-4e2a-9c4e-6a8c0e2a4c92",
      "credentials": {
        "inventoryApi": {
          "id": "inventoryApiCred",
          "name": "Inventory API"
        }
      },
      "notes": "Publishing this workflow registers its own webhook with POST /api/hooks. No WEBHOOK_SUBSCRIPTIONS entry needed.",
      "parameters": {
        "events": ["inventory.low_stock"],
        "verifySignature": true,
        "output": "data"
      }
    },
    {
      "id": "6c8e0a2c-4e6a-4c8e-9a2c-4e6a8c0e2a93",
      "name": "Create purchase order",
      "type": "CUSTOM.inventory",
      "typeVersion": 1,
      "position": [240, 0],
      "credentials": {
        "inventoryApi": {
          "id": "inventoryApiCred",
          "name": "Inventory API"
        }
      },
      "parameters": {
        "resource": "purchaseOrder",
        "operation": "create",
        "sku": "={{ $json.product.sku }}",
        "qtyMode": "atLeast",
        "qty": "={{ $json.suggestedReorderQty }}",
        "poReason": "low_stock"
      }
    }
  ],
  "connections": {
    "Inventory Trigger": {
      "main": [[{ "node": "Create purchase order", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false,
  "tags": []
}
