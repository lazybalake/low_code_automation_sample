# Docker Compose reads this file as .env (cp .env.example .env).
# Running the API without Docker? Use app/.env.example instead.

# Required. Every /api call sends this in the x-api-key header.
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=change-me-to-a-long-random-string

# Signs webhook deliveries to the static routes below (x-inventory-signature).
WEBHOOK_SECRET=change-me-too

STORE_NAME="Trailhead Supply Co."
TZ=America/New_York
N8N_VERSION=2.44.5

# Event -> URL routes. Leave unset to use the n8n defaults from docker-compose.yml.
# To add Make, copy the defaults and append your Make custom webhook URL:
# WEBHOOK_SUBSCRIPTIONS=order.created=http://n8n:5678/webhook/inv-order-created,inventory.low_stock=http://n8n:5678/webhook/inv-low-stock,purchase_order.created=https://hook.us1.make.com/REPLACE_ME
