{
  // Dedicated, attached webhook: Make registers its URL with the API when the scenario starts.
  "url": "/hooks",
  "method": "POST",
  "body": {
    "targetUrl": "{{webhook.url}}",
    "events": "{{parameters.events}}"
  },
  "response": {
    "data": {
      "externalHookId": "{{body.id}}"
    }
  }
}
