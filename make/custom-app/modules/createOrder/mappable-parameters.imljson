[
  { "name": "customerName", "type": "text", "label": "Customer name", "required": true },
  { "name": "customerEmail", "type": "email", "label": "Customer email", "required": true },
  {
    "name": "items",
    "type": "array",
    "label": "Line items",
    "required": true,
    "spec": [
      { "name": "sku", "type": "text", "label": "SKU", "required": true },
      { "name": "qty", "type": "uinteger", "label": "Quantity", "required": true }
    ]
  },
  { "name": "externalId", "type": "text", "label": "External ID", "help": "Same External ID twice returns the existing order." },
  { "name": "note", "type": "text", "label": "Note" }
]
