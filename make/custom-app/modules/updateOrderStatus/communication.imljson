{
  "url": "/orders/{{parameters.orderId}}/status",
  "method": "POST",
  "body": {
    "status": "{{parameters.status}}",
    "carrier": "{{parameters.carrier}}",
    "trackingNumber": "{{parameters.trackingNumber}}",
    "note": "{{parameters.note}}"
  },
  "response": {
    "output": "{{body}}"
  }
}
