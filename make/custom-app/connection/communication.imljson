{
  // Runs when the connection is created to check the key works.
  "url": "{{parameters.baseUrl}}/api/me",
  "headers": {
    "x-api-key": "{{parameters.apiKey}}"
  },
  "response": {
    "metadata": {
      "type": "text",
      "value": "{{body.storeName}}"
    },
    "error": {
      "message": "[{{statusCode}}] {{body.error.message}}"
    }
  },
  "log": {
    "sanitize": ["request.headers.x-api-key"]
  }
}
