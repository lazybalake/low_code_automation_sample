{
  "name": "inventory-order-api",
  "version": "1.0.0",
  "description": "Inventory management and order flow API that n8n, Zapier and Make plug into.",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "demo": "node --env-file-if-exists=.env scripts/demo.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
