# Copy to .env (cp .env.example .env). Docker Compose reads the .env in the project root instead.

PORT=3000
STORE_NAME="Trailhead Supply Co."
CURRENCY=USD

# Every /api request needs this in an x-api-key header. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=change-me-to-a-long-random-string

# Signs static webhook deliveries (x-inventory-signature). Hooks created through
# POST /api/hooks get their own secret instead.
WEBHOOK_SECRET=change-me-too

# Fixed event -> URL routes. Comma-separated; use | for several events, * for all.
# Example for local n8n + a Make webhook:
# WEBHOOK_SUBSCRIPTIONS=order.created=http://localhost:5678/webhook/inv-order-created,inventory.low_stock=http://localhost:5678/webhook/inv-low-stock,purchase_order.created=https://hook.us1.make.com/your-hook-id
WEBHOOK_SUBSCRIPTIONS=

# Where data lives. Use :memory: for a throwaway run.
DATA_FILE=./data/db.json

# The public URL of this API (your tunnel) so Zapier and Make can reach it.
PUBLIC_BASE_URL=

LOG_LEVEL=info
