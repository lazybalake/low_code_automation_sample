# Local settings. Copy to .env.local (cp .env.example .env.local). Only the npm scripts that run locally load it
# (dev, offline, streams, db:*, demo), so nothing here is ever deployed.

# Every /api request needs this in an x-api-key header. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Deployed stages read theirs from SSM instead (docs/DEPLOY-AWS.md).
API_KEY=change-me-to-a-long-random-string

# Signs webhook deliveries to WEBHOOK_SUBSCRIPTIONS (x-inventory-signature). Hooks created through
# POST /api/hooks get their own secret instead.
WEBHOOK_SECRET=change-me-too

# DynamoDB Local from the root docker-compose.yml. Its fake keys keep local runs away from your real AWS account.
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

STORE_NAME="Trailhead Supply Co."
CURRENCY=USD

# Fixed event -> URL routes. Comma-separated; | for several events, * for all. Example for a Make custom webhook:
# WEBHOOK_SUBSCRIPTIONS=purchase_order.created=https://hook.us1.make.com/your-hook-id
WEBHOOK_SUBSCRIPTIONS=

# Low stock and backorders raise purchase orders automatically (the reorder function). Set to false to turn it off.
AUTO_REORDER=true

LOG_LEVEL=info
