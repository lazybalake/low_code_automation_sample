{
  "name": "inventory-api",
  "version": "1.0.0",
  "description": "Inventory and order API as an AWS Lambda function, answering from mock data. Make scenarios call it over HTTPS.",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/serverless/bin/serverless.js offline --stage local --useInProcess",
    "demo": "node --env-file-if-exists=.env scripts/demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p .",
    "deploy": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "info": "serverless info --stage dev",
    "logs": "serverless logs --stage dev --tail -f api"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.18.0",
    "esbuild": "^0.27.2",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.57.2",
    "serverless-offline": "^13.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
